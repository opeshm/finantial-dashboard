{
  "name": "finantial-dashboard",
  "version": "1.0.3",
  "scripts": {
    "ng": "ng",
    "start": "npm run web:dev",
    "web:dev": "ng serve --project ng-tailadmin --port 4310 --proxy-config apps/dashboard/proxy.conf.json",
    "web:build": "ng build --project ng-tailadmin",
    "web:watch": "ng build --project ng-tailadmin --watch --configuration development",
    "web:test": "ng test --project ng-tailadmin",
    "api": "npm run api:dev",
    "api:dev": "npm --prefix apps/api run dev",
    "api:build": "npm --prefix apps/api run build",
    "api:test": "npm --prefix apps/api test",
    "dev": "concurrently -n api,web -c cyan,green \"npm run api:dev\" \"npm run web:dev\"",
    "build": "npm run web:build && npm run api:build",
    "watch": "npm run web:watch",
    "test": "npm run api:test"
  },
  "private": true,
  "dependencies": {
    "@amcharts/amcharts5": "^5.13.5",
    "@amcharts/amcharts5-geodata": "^5.1.4",
    "@angular/cdk": "^21.2.2",
    "@angular/common": "^21.2.4",
    "@angular/compiler": "^21.2.4",
    "@angular/core": "^21.2.4",
    "@angular/forms": "^21.2.4",
    "@angular/platform-browser": "^21.2.4",
    "@angular/platform-browser-dynamic": "^21.2.4",
    "@angular/router": "^21.2.4",
    "@fullcalendar/angular": "^6.1.20",
    "@fullcalendar/core": "^6.1.20",
    "@fullcalendar/daygrid": "^6.1.20",
    "@fullcalendar/interaction": "^6.1.20",
    "@fullcalendar/timegrid": "^6.1.20",
    "@popperjs/core": "^2.11.8",
    "@tailwindcss/postcss": "^4.1.11",
    "@types/prismjs": "^1.26.5",
    "apexcharts": "^5.3.2",
    "flatpickr": "^4.6.13",
    "ng-apexcharts": "^2.0.4",
    "ng-otp-input": "^2.0.9",
    "postcss": "^8.5.6",
    "prismjs": "^1.30.0",
    "rxjs": "~7.8.0",
    "swiper": "^11.2.10",
    "tailwindcss": "^4.1.11",
    "tslib": "^2.3.0",
    "zone.js": "~0.15.0"
  },
  "devDependencies": {
    "@angular/build": "^21.2.2",
    "@angular/cli": "^21.2.2",
    "@angular/compiler-cli": "^21.2.4",
    "@types/jasmine": "~5.1.0",
    "jasmine-core": "~5.6.0",
    "karma": "~6.4.0",
    "karma-chrome-launcher": "~3.2.0",
    "karma-coverage": "~2.2.0",
    "karma-jasmine": "~5.1.0",
    "karma-jasmine-html-reporter": "~2.1.0",
    "playwright": "^1.59.1",
    "postcss": "^8.5.3",
    "concurrently": "^9.2.1",
    "typescript": "~5.9.3"
  },
  "optionalDependencies": {
    "@tailwindcss/oxide-linux-x64-gnu": "^4.1.12",
    "lightningcss-linux-x64-gnu": "^1.30.1"
  }
}
